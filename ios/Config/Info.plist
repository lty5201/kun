<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CADisableMinimumFrameDurationOnPhone</key>
    <true/>
    <!-- An empty UILaunchScreen opts the app into native full-screen rendering
         on every device. It MUST be declared explicitly here: the
         INFOPLIST_KEY_UILaunchScreen_Generation build setting produced a
         MALFORMED, nested value (UILaunchScreen -> { UILaunchScreen -> {} }),
         which iOS does not recognise as a valid launch screen — so large
         devices (e.g. iPhone 15 Pro Max) fell back to letterboxed
         compatibility mode (#71). The generation setting is removed in
         Shared.xcconfig in favour of this flat, correct declaration. -->
    <key>UILaunchScreen</key>
    <dict/>
    <!-- Distribution channel, substituted from KUMONE_DISTRIBUTION: sideload by
         default (Shared.xcconfig), testflight from TestFlight.xcconfig. Read by
         DistributionChannel to decide whether the in-app updater may run. -->
    <key>KumoneDistribution</key>
    <string>$(KUMONE_DISTRIBUTION)</string>
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
        <string>location</string>
    </array>
    <!-- Live Activities (lyrics on the Dynamic Island / Lock Screen).
         Frequent updates only raises the update budget; it does not remove
         Apple's throttling or the 8-hour lifetime. -->
    <key>NSSupportsLiveActivities</key>
    <true/>
    <key>NSSupportsLiveActivitiesFrequentUpdates</key>
    <true/>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>sb.moe.kumone-ios.lyrics-refresh</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>kumone</string>
            </array>
        </dict>
    </array>
    <!-- Only used when the user enables the opt-in "位置保活" switch, and
         only while the lyrics Live Activity runs. WhenInUse only, coarse
         accuracy; location values are never read or stored. -->
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>在后台播放歌词灵动岛期间，使用位置保持应用活跃，以便歌词继续更新；仅在你开启「位置保活」且灵动岛运行时才定位，停止播放或关闭灵动岛后即停止。位置数据不会被读取或上传。</string>
    <!-- Expose the app's Documents folder in the Files app (On My iPhone ▸
         Kumone) so a downloaded update IPA is findable and can be imported into
         a signing tool. (#73, #50) -->
    <key>UIFileSharingEnabled</key>
    <true/>
    <key>LSSupportsOpeningDocumentsInPlace</key>
    <true/>
    <!-- Register as a handler for .js files so a Luoxue source script can be
         imported from the Files app via 长按 → 分享 → 零音乐 (Open In). This is
         the fallback import path that does not depend on the in-app document
         picker at all. -->
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>JavaScript 音源脚本</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>sb.moe.kumone.javascript-source</string>
            </array>
        </dict>
    </array>
    <key>UTImportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>sb.moe.kumone.javascript-source</string>
            <key>UTTypeDescription</key>
            <string>JavaScript 音源脚本</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.data</string>
                <string>public.text</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>js</string>
                </array>
            </dict>
        </dict>
    </array>
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>
    <!-- CarPlay is deliberately absent from this file. UISupportsCarPlay and the
         CPTemplateApplicationSceneSessionRoleApplication scene declaration are injected
         into a generated copy of this plist by `make configure-carplay`, because the
         CarPlay audio entitlement they depend on requires per-app approval from Apple.
         See Scripts/configure-ios.sh and the CarPlay section of the README. -->
</dict>
</plist>
